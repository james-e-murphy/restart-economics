# Raw archives are never committed: large, third-party, separately licensed.
archives/*.tar.gz
archives/*.zip
archives/*.manifest.txt
archives/.partial/

# Derived tables stay local: the upstream release records no license
data/derived/*/

# Extraction intermediates
reduced/
normalized/
scratch/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Local run logs
data/derived/*.log

# Paper build outputs, regenerated by paper/build/build.sh
paper/build/figures/
paper/build/body.md
paper/build/_t.txt
paper/build/*.pdf
